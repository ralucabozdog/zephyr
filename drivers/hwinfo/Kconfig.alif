config HWINFO_ALIF
	bool "Alif hwinfo driver"
	default y
	depends on SOC_FAMILY_BALLETTO || SOC_FAMILY_ENSEMBLE_RTSS
	select HWINFO_HAS_DRIVER
	help
	  Enable the Alif hwinfo driver, which reports the SoC serial number
	  read from the Secure Enclave as device ID.
